#pragma code_page(65001)
1 ICON "assets/daozai.ico"

#define APP_VERSION 1,3,1,0
#define APP_VERSION_TEXT "1.3.1"
#define VERSION_HEADER 1 VERSIONINFO FILEVERSION APP_VERSION PRODUCTVERSION APP_VERSION \
    FILEFLAGSMASK 0x3fL FILEFLAGS 0x0L FILEOS 0x40004L FILETYPE 0x1L FILESUBTYPE 0x0L
#define VERSION_STRINGS(description, product, publisher) \
    VALUE "FileDescription", description \
    VALUE "InternalName", "Daozai" \
    VALUE "OriginalFilename", "daozai.exe" \
    VALUE "ProductName", product \
    VALUE "CompanyName", publisher \
    VALUE "ProductVersion", APP_VERSION_TEXT \
    VALUE "FileVersion", APP_VERSION_TEXT

LANGUAGE 0x04, 0x02
VERSION_HEADER
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VERSION_STRINGS("岛仔", "岛仔 Daozai", "迟迟")
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

LANGUAGE 0x09, 0x01
VERSION_HEADER
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VERSION_STRINGS("Daozai", "Daozai", "chichi")
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
